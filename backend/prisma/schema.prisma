// BrokerBuddy data model.
//
// Design rules enforced here:
//  - Everything is scoped to a Brokerage (team) — no cross-tenant access.
//  - Client phone numbers are unique per brokerage (duplicate prevention).
//  - Client requirements (Inquiry) are stored separately from Property inventory.
//  - Every requirement change is appended to InquiryRevision (never rewritten).
//  - Optional fields stay NULL when unknown — we never invent client data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

enum LeadSource {
  WALK_IN
  REFERRAL
  PHONE_CALL
  WHATSAPP
  ACRES_99
  HOUSING_COM
  MAGICBRICKS
  WEBSITE
  SOCIAL_MEDIA
  OTHER
}

enum ClientStatus {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

enum TransactionType {
  RENT
  BUY
}

enum PropertyCategory {
  STUDIO
  BHK_1
  BHK_2
  BHK_3
  BHK_4
  BHK_5_PLUS
  COMMERCIAL
  OTHER
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum Possession {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum InquiryStatus {
  ACTIVE
  PAUSED
  FULFILLED
  DROPPED
}

// Requirement fields a broker can flag as mandatory ("must have").
enum RequirementField {
  BUDGET
  LOCATION
  FURNISHING
  PARKING
  FLOOR
  POSSESSION
}

enum RequirementSource {
  MANUAL
  VOICE_NOTE
  PORTAL_LEAD
  WHATSAPP
}

enum VoiceLanguage {
  AUTO
  HINDI
  HINGLISH
  MARATHI
  ENGLISH
}

// NEEDS_TRANSCRIPT: audio stored but not transcribed (STT unavailable/failed) – agent types it.
// READY: transcript + extracted draft awaiting the agent's review.
// APPLIED: reviewed draft saved to an inquiry. DISCARDED: agent threw it away.
enum VoiceNoteStatus {
  NEEDS_TRANSCRIPT
  READY
  APPLIED
  DISCARDED
}

// Where a client note was written from.
enum NoteSource {
  MANUAL
  CALLER_SCREEN
  NOTIFICATION
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// API = received/sent through the WhatsApp Business Platform; MANUAL = shared or imported by an agent.
enum MessageChannel {
  API
  MANUAL
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

// Whether the requirement draft extracted from a message has been reviewed.
enum DraftReview {
  NONE
  PENDING
  APPLIED
  DISMISSED
}

enum Availability {
  AVAILABLE
  ON_HOLD
  RENTED
  SOLD
  WITHDRAWN
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

model Brokerage {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  clients    Client[]
  phones     ClientPhone[]
  inquiries  Inquiry[]
  properties Property[]
  reminders  Reminder[]
  voiceNotes VoiceNote[]
  notes      ClientNote[]
  whatsappAccounts WhatsAppAccount[]
  whatsappContacts WhatsAppContact[]
  whatsappMessages WhatsAppMessage[]
}

model User {
  id           String   @id @default(cuid())
  brokerageId  String
  brokerage    Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  assignedClients   Client[]          @relation("AssignedClients")
  reminders         Reminder[]        @relation("ReminderAssignee")
  createdReminders  Reminder[]        @relation("ReminderCreator")
  inquiryRevisions  InquiryRevision[]
  listedProperties  Property[]
  voiceNotes        VoiceNote[]
  clientNotes       ClientNote[]

  @@index([brokerageId])
}

model Client {
  id           String       @id @default(cuid())
  brokerageId  String
  brokerage    Brokerage    @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  name         String
  // Primary phone in E.164 form (e.g. +919820012345). Also present in ClientPhone.
  primaryPhone String
  email        String?
  leadSource   LeadSource
  status       ClientStatus @default(NEW)
  notes        String?
  assignedToId String?
  assignedTo   User?        @relation("AssignedClients", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  phones     ClientPhone[]
  inquiries  Inquiry[]
  reminders  Reminder[]
  voiceNotes VoiceNote[]
  conversationNotes ClientNote[]
  whatsappContacts  WhatsAppContact[]
  whatsappMessages  WhatsAppMessage[]

  @@index([brokerageId, status])
  @@index([brokerageId, name])
}

// All numbers belonging to a client. The unique constraint is the database-level
// guarantee that one phone number maps to exactly one client per brokerage.
model ClientPhone {
  id          String    @id @default(cuid())
  brokerageId String
  brokerage   Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  e164        String
  label       String?

  @@unique([brokerageId, e164])
  @@index([clientId])
}

// One client inquiry / requirement. A client may have many (e.g. rent a 1BHK now,
// buy a 2BHK later). NULL means "not specified by the client".
model Inquiry {
  id              String            @id @default(cuid())
  brokerageId     String
  brokerage       Brokerage         @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactionType TransactionType
  category        PropertyCategory
  status          InquiryStatus     @default(ACTIVE)
  // Budget in whole rupees. For RENT this is monthly rent.
  budgetMin       BigInt?
  budgetMax       BigInt?
  locations       String[]
  furnishing      Furnishing[]
  minParking      Int?
  floorMin        Int?
  floorMax        Int?
  possession      Possession?
  possessionBy    DateTime?
  mandatory       RequirementField[]
  notes           String?
  source          RequirementSource @default(MANUAL)
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  revisions  InquiryRevision[]
  reminders  Reminder[]
  voiceNotes VoiceNote[]
  whatsappMessages WhatsAppMessage[]

  @@index([brokerageId, transactionType, category, status])
  @@index([clientId])
}

// Append-only history of requirement changes.
model InquiryRevision {
  id          String            @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  version     Int
  changedById String?
  changedBy   User?             @relation(fields: [changedById], references: [id], onDelete: SetNull)
  source      RequirementSource
  // { field: { from, to } } for updates; full snapshot for version 1.
  changes     Json
  snapshot    Json
  // Set when the change came from a reviewed voice note.
  voiceNoteId String?
  voiceNote   VoiceNote?        @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  // Set when the change came from a reviewed WhatsApp message.
  whatsappMessageId String?
  whatsappMessage   WhatsAppMessage? @relation(fields: [whatsappMessageId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@unique([inquiryId, version])
}

// A recorded (or typed) note about a client's requirement, its transcript and the
// AI-extracted draft. The draft never touches the inquiry until an agent reviews it.
model VoiceNote {
  id                 String          @id @default(cuid())
  brokerageId        String
  brokerage          Brokerage       @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Inquiry the note is about (chosen when recording, or when applied).
  inquiryId          String?
  inquiry            Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  language           VoiceLanguage   @default(AUTO)
  status             VoiceNoteStatus
  audio              Bytes?
  audioMimeType      String?
  audioSize          Int?
  durationMs         Int?
  // As produced by speech-to-text, kept for audit even if the agent corrects it.
  originalTranscript String?
  transcript         String?
  transcriptSource   String?         // "stt:<provider>" or "manual"
  extraction         Json?
  extractor          String?
  error              String?
  appliedVersion     Int?
  appliedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  revisions InquiryRevision[]

  @@index([brokerageId, clientId, createdAt])
}

model Property {
  id              String           @id @default(cuid())
  brokerageId     String
  brokerage       Brokerage        @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  title           String
  transactionType TransactionType
  category        PropertyCategory
  // Whole rupees. For RENT: monthly rent. For BUY: total price.
  price           BigInt
  deposit         BigInt?
  locality        String
  building        String?
  address         String?
  carpetAreaSqft  Int?
  furnishing      Furnishing?
  parkingSpots    Int?
  floor           Int?
  totalFloors     Int?
  possession      Possession?
  possessionDate  DateTime?
  availability    Availability     @default(AVAILABLE)
  ownerName       String?
  ownerPhone      String?
  notes           String?
  listedById      String?
  listedBy        User?            @relation(fields: [listedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([brokerageId, transactionType, category, availability])
}

model Reminder {
  id           String         @id @default(cuid())
  brokerageId  String
  brokerage    Brokerage      @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inquiryId    String?
  inquiry      Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  assignedToId String
  assignedTo   User           @relation("ReminderAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?          @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueAt        DateTime
  title        String
  note         String?
  status       ReminderStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  @@index([brokerageId, assignedToId, status, dueAt])
}

// A conversation note on a client (e.g. typed on the caller screen after a call).
model ClientNote {
  id          String     @id @default(cuid())
  brokerageId String
  brokerage   Brokerage  @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  source      NoteSource @default(MANUAL)
  createdAt   DateTime   @default(now())

  @@index([clientId, createdAt])
}

// A brokerage's WhatsApp Business phone number connected through Meta's Cloud API.
// Secrets are stored encrypted (AES-256-GCM, key from DATA_ENCRYPTION_KEY).
model WhatsAppAccount {
  id             String    @id @default(cuid())
  brokerageId    String
  brokerage      Brokerage @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  phoneNumberId  String    @unique
  wabaId         String?
  displayPhone   String?
  accessTokenEnc String
  appSecretEnc   String
  // Unguessable path segment of this account's webhook URL, and the token Meta echoes during verification.
  webhookKey     String    @unique
  verifyToken    String
  verifiedAt     DateTime?
  lastEventAt    DateTime?
  createdAt      DateTime  @default(now())

  contacts WhatsAppContact[]
  messages WhatsAppMessage[]
}

// One WhatsApp user who messaged (or was messaged by) a connected number.
model WhatsAppContact {
  id            String           @id @default(cuid())
  brokerageId   String
  brokerage     Brokerage        @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  accountId     String?
  account       WhatsAppAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  waId          String           // E.164
  profileName   String?
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lastInboundAt DateTime?
  createdAt     DateTime         @default(now())

  messages WhatsAppMessage[]

  @@unique([brokerageId, waId])
}

model WhatsAppMessage {
  id            String           @id @default(cuid())
  brokerageId   String
  brokerage     Brokerage        @relation(fields: [brokerageId], references: [id], onDelete: Cascade)
  accountId     String?
  account       WhatsAppAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       WhatsAppContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Client and inquiry this message is about (may differ from the sender for forwarded portal leads).
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inquiryId     String?
  inquiry       Inquiry?         @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  channel       MessageChannel
  direction     MessageDirection
  // WhatsApp message id (wamid) for API messages; content hash for manual imports. Dedupes retries/re-imports.
  externalId    String
  type          String
  text          String?
  mediaId       String?
  mediaMimeType String?
  senderName    String?
  sentAt        DateTime
  status        MessageStatus
  errorReason   String?
  // Who the message is about: the portal lead's phone/name, or the sender.
  leadPhone     String?
  leadName      String?
  portal        String?
  portalLead    Json?
  extraction    Json?
  review        DraftReview      @default(NONE)
  processedAt   DateTime?
  processError  String?
  raw           Json?
  createdAt     DateTime         @default(now())

  revisions InquiryRevision[]

  @@unique([brokerageId, externalId])
  @@index([brokerageId, clientId, sentAt])
  @@index([brokerageId, review])
  @@index([processedAt])
}
