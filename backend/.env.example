DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brokerbuddy"
# At least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=""
PORT=4000

# --- Phase 2: voice notes (all optional) ---
# Speech-to-text: any service exposing the Whisper-style POST /audio/transcriptions API.
# Without STT_URL, recordings are stored and the agent types the transcript instead.
STT_URL=""            # e.g. https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=""
STT_MODEL="whisper-1"
# Requirement extraction uses Claude when an Anthropic key is present, otherwise the
# built-in Hindi/Hinglish/Marathi/English rules. Set EXTRACTOR=rules to force rules.
ANTHROPIC_API_KEY=""
EXTRACTOR=""

# When a 99acres / Housing.com / Magicbricks enquiry doesn't say rent or sale, the server
# opens the listing link in it (portal domains and Housing's app.link short links only)
# and reads rent/sale from the page address or title. Set to "off" to never open links.
LISTING_LOOKUP="on"

# --- Phase 4: WhatsApp Business Platform (see docs/WHATSAPP.md) ---
# Required before connecting a number: encrypts stored access tokens/app secrets.
DATA_ENCRYPTION_KEY=""        # openssl rand -hex 32
WHATSAPP_GRAPH_VERSION="v23.0" # use a currently supported Graph API version
