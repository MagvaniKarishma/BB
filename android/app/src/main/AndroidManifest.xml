<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminder notifications (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice notes (runtime permission; typing the note is the fallback if denied). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Caller screen: optional floating card ("Display over other apps", granted in system settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional: lets the system pass calls from saved phone contacts on versions that require it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".BrokerBuddyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrokerBuddy">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Manual WhatsApp alternative: share a message or an exported chat (.txt) to BrokerBuddy. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Incoming-call detection via the call-screening role (Android 10+). Only the
             system (holding BIND_SCREENING_SERVICE) can bind to it; disabled below Android 10. -->
        <service
            android:name=".calls.BrokerCallScreeningService"
            android:enabled="@bool/call_screening_supported"
            android:exported="true"
            tools:targetApi="29"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".calls.NoteReplyReceiver"
            android:exported="false" />
    </application>

    <!-- Package visibility for launching WhatsApp / dialer intents (Android 11+). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>
</manifest>
